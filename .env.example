# Copiez ce fichier vers .env.local puis remplissez les valeurs.
# .env.local n'est jamais versionné : aucun identifiant ne doit finir sur GitHub.

# Chaîne de connexion PostgreSQL fournie par Neon.
# Console Neon > votre projet > Connection string (pooled connection).
DATABASE_URL=""

# Identifiants Cloudinary pour l'hébergement des images d'objets (§7).
# Console Cloudinary > Dashboard > « API environment variable », à copier tel quel.
# Forme attendue : cloudinary://<api_key>:<api_secret>@<cloud_name>
# Nécessaire uniquement pour l'upload des images.
CLOUDINARY_URL=""

# Clé de signature des sessions (JWT dans un cookie httpOnly).
# Générez-en une différente par environnement :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
