# Copiez ce fichier vers .env.local puis remplissez les valeurs.
# .env.local n'est jamais versionné : aucun identifiant ne doit finir sur GitHub.

# Chaîne de connexion PostgreSQL fournie par Neon.
# Console Neon > votre projet > Connection string (pooled connection).
DATABASE_URL=""

# Jeton d'écriture du CDN d'images (§7), à créer depuis Vercel > Storage > Blob.
# Nécessaire uniquement pour l'upload des images d'objets.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Cle de signature des sessions (JWT dans un cookie httpOnly).
# Generez-en une differente par environnement :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
